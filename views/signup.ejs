<%- include("partials/header") %>

<section class="auth-layout">
  <div class="auth-poster">
    <p class="eyebrow">Build a library</p>
    <h1>Save the films that matter.</h1>
    <p class="hero-copy">Upload videos, keep posters, and return to your collection anytime.</p>
  </div>

  <div class="card form-card auth-card">
    <p class="eyebrow">Start your vault</p>
    <h1>Create Account</h1>

    <form action="/signup" method="POST">

      <div class="form-group">
        <label>Username</label>
        <input type="text" name="username" placeholder="Enter username" required>
      </div>

      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" placeholder="Enter email" required>
      </div>

      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Enter password" required>
      </div>

      <button>Signup</button>
    </form>

    <div class="auth-link">
      <p>Already have an account? <a href="/signin">Signin</a></p>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
