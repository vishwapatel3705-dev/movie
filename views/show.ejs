<%- include("partials/header") %>

<% const isVideo = movie.coverImage && (movie.mediaType === "video" || /\.(mp4|webm|ogg|mov|m4v|avi|mkv)$/i.test(movie.coverImage || "")); %>

<article class="details">
  <% if (movie.coverImage) { %>
    <div class="details-player">
      <% if (isVideo) { %>
        <video class="details-media" src="/uploads/<%= movie.coverImage %>" controls preload="metadata"></video>
      <% } else { %>
        <img class="details-media" src="/uploads/<%= movie.coverImage %>" alt="<%= movie.title %> poster">
      <% } %>
    </div>
  <% } %>

  <div class="details-copy">
    <p class="eyebrow">Movie details</p>
    <h1><%= movie.title %></h1>
    <p class="muted">Directed by <%= movie.director %></p>
    <span class="media-pill"><%= isVideo ? "Playable video" : "Poster image" %></span>
    <p class="synopsis"><%= movie.description %></p>

    <div class="actions">
      <a class="button-link" href="/movies/<%= movie._id %>/edit">Edit Movie</a>
      <a class="text-link" href="/movies">Back to Movies</a>
    </div>
  </div>
</article>

<%- include("partials/footer") %>
